/**
 * =========================
 * ENUMS (simples)
 * =========================
 */
enum StatutCompte {
  ACTIF
  INACTIF
  SUSPENDU
}

enum StatutInscription {
  PREINSCRIT
  INSCRIT
  EN_ATTENTE_PAIEMENT
  VALIDEE
  DOSSIER_INCOMPLET
  ANNULEE
  TRANSFERE
  SUSPENDUE
  SORTI
}

enum TypeInscription {
  NOUVELLE_INSCRIPTION
  REINSCRIPTION
  TRANSFERT_ENTRANT
  REDOUBLEMENT
  PASSAGE_CLASSE_SUPERIEURE
}

enum StatutAdministratifInscription {
  EN_ATTENTE
  DOSSIER_INCOMPLET
  EN_ATTENTE_VERIFICATION
  VALIDE
  REJETE
  ANNULE
}

enum StatutFinancierInscription {
  NON_FACTURE
  FACTURE
  NON_PAYE
  PARTIELLEMENT_PAYE
  PAYE
  EN_RETARD
  EXONERE
  ANNULE
}

enum StatutDossierInscription {
  COMPLET
  INCOMPLET
  EN_ATTENTE_VERIFICATION
  VALIDE
  REJETE
}

enum StatutDocumentInscription {
  NON_FOURNI
  FOURNI
  EN_ATTENTE_VERIFICATION
  VALIDE
  REJETE
  EXPIRE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
}

enum StatutFacture {
  BROUILLON
  EMISE
  PARTIELLE
  PAYEE
  ANNULEE
  EN_RETARD
}

enum StatutEcheancePaiement {
  A_VENIR
  PARTIELLE
  PAYEE
  ANNULEE
  EN_RETARD
}

enum StatutPromessePaiement {
  EN_ATTENTE
  TENUE
  ROMPUE
  ANNULEE
}

enum TypeRestrictionAdministrative {
  BULLETIN
  EXAMEN
  REINSCRIPTION
}

enum StatutRestrictionAdministrative {
  ACTIVE
  LEVEE
  ANNULEE
}

enum StatutDossierRecouvrement {
  OUVERT
  RENFORCE
  CONTENTIEUX
  IRRECOUVRABLE
  ABANDON_EN_ATTENTE
  ABANDONNE
  CLOTURE
}

enum TypeCanal {
  EMAIL
  SMS
  APP
}

enum TypeEvaluation {
  DEVOIR
  EXAMEN
  ORAL
  AUTRE
}

enum ReportCardTemplateType {
  STANDARD
  DETAILED
  ASSESSMENT_TYPE_SUMMARY
  FINAL_EXAM_ONLY
  CUSTOM
}

enum PedagogicalDisplayMode {
  SUBJECTS_ONLY
  SUBJECTS_AND_DOMAINS
  FULL_HIERARCHY
  COMPETENCIES_ONLY
  CUSTOM
}

enum PedagogicalItemType {
  SUBJECT
  GROUP
  DOMAIN
  SUBDOMAIN
  COMPETENCY
  OBJECTIVE
}

enum PedagogicalCalculationMode {
  NONE
  SIMPLE_AVERAGE
  WEIGHTED_AVERAGE
  SUM
  MANUAL
}

enum StatutProgramme {
  DRAFT
  ACTIVE
  IN_REVISION
  LOCKED
  ARCHIVED
}

enum StatutProgrammeMatiere {
  ACTIVE
  INACTIVE
  DISABLED
}

enum GradingType {
  POINTS
  LETTER
  LEVEL
  DESCRIPTIVE
  PERCENTAGE
  VALIDATION
}

enum AssessmentWorkflowStatus {
  DRAFT
  PUBLISHED
  RESULTS_ENTERED
  VALIDATED
  LOCKED
  ARCHIVED
}

enum AssessmentResultStatus {
  GRADED
  JUSTIFIED_ABSENCE
  UNJUSTIFIED_ABSENCE
  EXEMPTED
  NOT_SUBMITTED
  NOT_EVALUATED
}

enum ReportAverageCalculationMode {
  SIMPLE
  HIERARCHICAL
}

enum BulletinGradingMode {
  NUMERIC
  CODE
  LEVEL
  DESCRIPTIVE
  MIXED
  NONE
}

enum ReportCardTemplateSectionType {
  ACADEMIC_NUMERIC
  ACADEMIC_CODE
  BEHAVIOR
  GENERAL_APPRECIATION
  DECISION
  CODE_LEGEND
  CUSTOM
}

/**
 * =========================
 * 1) NOYAU
 * =========================
 */
model Etablissement {
  id              String  @id @default(uuid())
  nom             String
  code            String? @unique
  fuseau_horaire  String? // ex: Indian/Antananarivo
  parametres_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sites                    Site[]
  annees                   AnneeScolaire[]
  etablissementReferenciel EtablissementReferenciel[]
  utilisateurs             Utilisateur[]
  roles                    Role[]
  permissions              Permission[]
  eleves                   Eleve[]
  personnel                Personnel[]
  departements             Departement[]
  matieres                 Matiere[]
  canaux                   CanalCommunication[]
  catalogueFrais           CatalogueFrais[]
  facturationsRecurrentes  FacturationRecurrenteExecution[]
  remises                  Remise[]
  reglesRecouvrement       RegleRecouvrementFinance[]
  promessesPaiement        PromessePaiement[]
  restrictionsAdministratives RestrictionAdministrative[]
  dossiersRecouvrement     DossierRecouvrement[]
  fichiers                 Fichier[]
  documentTypesInscription DocumentTypeInscription[]
  journauxAudit            JournalAudit[]
  webhooks                 Webhook[]
  jetons                   JetonIntegration[]
  ParentTuteur             ParentTuteur[]
  NiveauScolaire           NiveauScolaire[]
  Classe                   Classe[]
  Programme                Programme[]
  Cours                    Cours[]
  RegleNote                RegleNote[]
  reportCardTemplates      ReportCardTemplate[]
  pedagogicalItems         PedagogicalItem[]
  gradingScales            GradingScale[]
  pedagogicalItemAverages  PedagogicalItemAverage[]
  EvenementCalendrier      EvenementCalendrier[]
  Annonce                  Annonce[]
  Message                  Message[]
  Facture                  Facture[]
  operationsFinancieres    OperationFinanciere[]

  @@map("etablissements")
}

model Site {
  id               String  @id @default(uuid())
  etablissement_id String
  nom              String
  adresse          String?
  telephone        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement         @relation(fields: [etablissement_id], references: [id])
  salles        Salle[]
  classes       Classe[]
  evenements    EvenementCalendrier[]

  @@index([etablissement_id])
  @@map("sites")
}

model AnneeScolaire {
  id               String   @id @default(uuid())
  etablissement_id String
  nom              String // ex: 2025-2026
  date_debut       DateTime
  date_fin         DateTime
  est_active       Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement        Etablissement         @relation(fields: [etablissement_id], references: [id])
  periodes             Periode[]
  classes              Classe[]
  inscriptions         Inscription[]
  programmes           Programme[]
  cours                Cours[]
  factures             Facture[]
  plansPaiement        PlanPaiementEleve[]
  echeancesPaiement    EcheancePaiement[]
  facturationsRecurrentes FacturationRecurrenteExecution[]
  abonnementsTransport AbonnementTransport[]
  abonnementsCantine   AbonnementCantine[]
  promessesPaiement    PromessePaiement[]
  restrictionsAdministratives RestrictionAdministrative[]
  dossiersRecouvrement DossierRecouvrement[]
  reportCardTemplates  ReportCardTemplate[]
  pedagogicalItems     PedagogicalItem[]
  gradingScales        GradingScale[]
  pedagogicalItemAverages PedagogicalItemAverage[]

  @@index([etablissement_id])
  @@map("annees_scolaires")
}

model Periode {
  id                String   @id @default(uuid())
  annee_scolaire_id String
  nom               String // Trimestre 1, Semestre 2...
  date_debut        DateTime
  date_fin          DateTime
  ordre             Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  annee       AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  evaluations Evaluation[]
  bulletins   Bulletin[]
  pedagogicalItemAverages PedagogicalItemAverage[]

  @@index([annee_scolaire_id])
  @@map("periodes")
}

model Salle {
  id       String  @id @default(uuid())
  site_id  String
  nom      String
  capacite Int?
  type     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  site          Site            @relation(fields: [site_id], references: [id])
  emploiDuTemps EmploiDuTemps[]

  @@index([site_id])
  @@map("salles")
}

model Referenciel {
  id    String @id @default(uuid())
  titre String
  code  String

  etablissementReferenciel EtablissementReferenciel[]

  @@map("referenciel")
}

model EtablissementReferenciel {
  id               String        @id @default(uuid())
  referenciel_id   String
  etablissement_id String
  valeur           String
  etablissement    Etablissement @relation(fields: [etablissement_id], references: [id])
  Referenciel      Referenciel?  @relation(fields: [referencielId], references: [id])
  referencielId    String?

  @@index([etablissement_id])
  @@map("etablissement_referenciel")
}

/**
 * =========================
 * 2) COMPTES & DROITS
 * =========================
 */
model Utilisateur {
  id                String       @id @default(uuid())
  etablissement_id  String?
  email             String?
  telephone         String?
  mot_de_passe_hash String?
  statut            StatutCompte @default(ACTIF)
  dernier_login     DateTime?
  scope_json        Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement       Etablissement?        @relation(fields: [etablissement_id], references: [id])
  profil              Profil?
  roles               UtilisateurRole[]
  messagesEnvoyes     Message[]             @relation("messages_envoyes")
  notifications       Notification[]
  fichiers            Fichier[]             @relation("fichiers_proprietaire")
  documentsInscriptionVerifies InscriptionDocument[] @relation("documents_inscription_verifies")
  journauxAudit       JournalAudit[]
  facturationsRecurrentes FacturationRecurrenteExecution[] @relation("facturation_recurrente_createur")
  operationsFinancieres OperationFinanciere[] @relation("operations_financieres_createur")
  cataloguesFraisApprouves CatalogueFrais[] @relation("catalogue_frais_approbateur")
  reglesRecouvrementApprouvees RegleRecouvrementFinance[] @relation("regle_recouvrement_approbateur")
  promessesPaiementCreees PromessePaiement[] @relation("promesse_paiement_createur")
  promessesPaiementValidees PromessePaiement[] @relation("promesse_paiement_validateur")
  restrictionsAdministrativesCreees RestrictionAdministrative[] @relation("restriction_admin_createur")
  restrictionsAdministrativesLevees RestrictionAdministrative[] @relation("restriction_admin_leveur")
  dossiersRecouvrementCrees DossierRecouvrement[] @relation("dossier_recouvrement_createur")
  dossiersRecouvrementValides DossierRecouvrement[] @relation("dossier_recouvrement_validateur")
  programmesCrees     Programme[]        @relation("programme_createur")
  programmesMaj       Programme[]        @relation("programme_modificateur")
  programmeChangeLogs ProgrammeChangeLog[] @relation("programme_change_log_actor")
  Eleve               Eleve[]
  ParentTuteur        ParentTuteur[]
  Personnel           Personnel[]
  MessageDestinataire MessageDestinataire[]

  @@unique([etablissement_id, email])
  @@index([etablissement_id])
  @@map("utilisateurs")
}

model Profil {
  id                   String    @id @default(uuid())
  utilisateur_id       String    @unique
  prenom               String
  nom                  String
  date_naissance       DateTime?
  lieu_naissance       String?
  nationalite          String?
  genre                String?
  photo_url            String?
  adresse              String?
  telephone_personnel  String?
  email_personnel      String?
  contact_urgence_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@map("profils")
}

model Role {
  id               String  @id @default(uuid())
  etablissement_id String?
  nom              String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  scope_json Json?

  etablissement Etablissement?    @relation(fields: [etablissement_id], references: [id])
  permissions   RolePermission[]
  utilisateurs  UtilisateurRole[]

  @@index([etablissement_id])
  @@map("roles")
}

model Permission {
  id               String  @id @default(uuid())
  etablissement_id String?
  code             String
  description      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement?   @relation(fields: [etablissement_id], references: [id])
  roles         RolePermission[]

  @@unique([etablissement_id, code])
  @@index([etablissement_id])
  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("roles_permissions")
}

model UtilisateurRole {
  utilisateur_id String
  role_id        String
  scope_json     Json?

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])
  role        Role        @relation(fields: [role_id], references: [id])

  @@id([utilisateur_id, role_id])
  @@map("utilisateurs_roles")
}

/**
 * =========================
 * 3) SCOLARITE
 * =========================
 */
model Eleve {
  id               String    @id @default(uuid())
  etablissement_id String
  code_eleve       String?
  utilisateur_id   String?
  statut           String? // simple
  date_entree      DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement        Etablissement           @relation(fields: [etablissement_id], references: [id])
  utilisateur          Utilisateur?            @relation(fields: [utilisateur_id], references: [id])
  liensParents         EleveParentTuteur[]
  inscriptions         Inscription[]
  identifiants         IdentifiantEleve[]
  notes                Note[]
  assessmentResults    AssessmentResult[]
  presences            PresenceEleve[]
  justificatifs        JustificatifAbsence[]
  incidents            IncidentDisciplinaire[]
  recompenses          Recompense[]
  bulletins            Bulletin[]
  factures             Facture[]
  plansPaiement        PlanPaiementEleve[]
  echeancesPaiement    EcheancePaiement[]
  facturationsRecurrentes FacturationRecurrenteExecution[]
  abonnementsTransport AbonnementTransport[]
  abonnementsCantine   AbonnementCantine[]
  promessesPaiement    PromessePaiement[]
  restrictionsAdministratives RestrictionAdministrative[]
  dossiersRecouvrement DossierRecouvrement[]
  emprunts             Emprunt[]
  profilMedical        EleveMedicalProfile?
  pedagogicalItemAverages PedagogicalItemAverage[]

  @@unique([etablissement_id, code_eleve])
  @@index([etablissement_id])
  @@map("eleves")
}

model EleveMedicalProfile {
  id                                  String   @id @default(uuid())
  eleve_id                            String   @unique
  groupe_sanguin                      String?
  allergies                           String?
  maladies_particulieres              String?
  traitement_medical                  String?
  medecin_traitant                    String?
  telephone_medecin                   String?
  autorisation_prise_en_charge_medicale Boolean @default(false)
  personne_a_contacter_urgence        String?
  telephone_urgence                   String?
  notes_json                          Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve Eleve @relation(fields: [eleve_id], references: [id], onDelete: Cascade)

  @@index([eleve_id])
  @@map("eleves_profils_medicaux")
}

model ParentTuteur {
  id               String  @id @default(uuid())
  etablissement_id String
  utilisateur_id   String?
  nom_complet      String
  telephone        String?
  telephone_secondaire String?
  email            String?
  adresse          String?
  profession       String?
  lieu_travail     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement       @relation(fields: [etablissement_id], references: [id])
  utilisateur   Utilisateur?        @relation(fields: [utilisateur_id], references: [id])
  eleves        EleveParentTuteur[]

  @@index([etablissement_id])
  @@map("parents_tuteurs")
}

model EleveParentTuteur {
  eleve_id              String
  parent_tuteur_id      String
  relation              String? // pere/mere/tuteur
  est_principal         Boolean @default(false)
  est_responsable_legal Boolean @default(false)
  est_responsable_financier Boolean @default(false)
  est_contact_urgence   Boolean @default(false)
  autorise_recuperation Boolean @default(true)

  eleve         Eleve        @relation(fields: [eleve_id], references: [id])
  parent_tuteur ParentTuteur @relation(fields: [parent_tuteur_id], references: [id])

  @@id([eleve_id, parent_tuteur_id])
  @@map("eleves_parents_tuteurs")
}

model NiveauScolaire {
  id               String @id @default(uuid())
  etablissement_id String
  nom              String
  ordre            Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  classes       Classe[]
  inscriptions  Inscription[]
  programmes    Programme[]
  catalogueFrais CatalogueFrais[]
  reportCardTemplates ReportCardTemplate[]
  pedagogicalItems PedagogicalItem[]

  @@index([etablissement_id])
  @@map("niveaux_scolaires")
}

model Classe {
  id                      String  @id @default(uuid())
  etablissement_id        String
  annee_scolaire_id       String
  niveau_scolaire_id      String
  site_id                 String?
  nom                     String // ex: 3A
  capacite                Int?
  enseignant_principal_id String? // référence vers Enseignant

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement        Etablissement  @relation(fields: [etablissement_id], references: [id])
  annee                AnneeScolaire  @relation(fields: [annee_scolaire_id], references: [id])
  niveau               NiveauScolaire @relation(fields: [niveau_scolaire_id], references: [id])
  site                 Site?          @relation(fields: [site_id], references: [id])
  enseignant_principal Enseignant?    @relation("classe_principal", fields: [enseignant_principal_id], references: [id])

  inscriptions  Inscription[]
  cours         Cours[]
  sessionsAppel SessionAppel[]
  bulletins     Bulletin[]
  pedagogicalItemAverages PedagogicalItemAverage[]
  emploiDuTemps EmploiDuTemps[]

  @@unique([annee_scolaire_id, nom, site_id])
  @@index([etablissement_id])
  @@index([annee_scolaire_id])
  @@map("classes")
}

model Inscription {
  id                   String                         @id @default(uuid())
  eleve_id             String
  niveau_scolaire_id   String?
  classe_id            String?
  annee_scolaire_id    String
  date_inscription     DateTime                       @default(now())
  type_inscription     TypeInscription                @default(NOUVELLE_INSCRIPTION)
  statut               StatutInscription              @default(INSCRIT)
  statut_administratif StatutAdministratifInscription @default(EN_ATTENTE)
  statut_financier     StatutFinancierInscription     @default(NON_FACTURE)
  statut_dossier       StatutDossierInscription       @default(INCOMPLET)
  validation_date      DateTime?
  completion_rate      Decimal?                       @db.Decimal(5, 2)
  acces_systeme_json   Json?
  consentements_json   Json?
  observations_json    Json?
  date_sortie          DateTime?
  raison_sortie        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve     Eleve               @relation(fields: [eleve_id], references: [id])
  niveau    NiveauScolaire?     @relation(fields: [niveau_scolaire_id], references: [id])
  classe    Classe?             @relation(fields: [classe_id], references: [id])
  annee     AnneeScolaire       @relation(fields: [annee_scolaire_id], references: [id])
  documents InscriptionDocument[]
  historiqueScolaire InscriptionSchoolHistory?

  @@unique([eleve_id, annee_scolaire_id])
  @@index([eleve_id])
  @@index([niveau_scolaire_id])
  @@index([classe_id])
  @@index([annee_scolaire_id])
  @@map("inscriptions")
}

model InscriptionSchoolHistory {
  id                  String   @id @default(uuid())
  inscription_id      String   @unique
  ancien_etablissement String?
  ancienne_classe     String?
  annee_precedente    String?
  derniere_moyenne    Decimal? @db.Decimal(5, 2)
  decision_precedente String?
  mention_precedente  String?
  motif_transfert     String?
  observations        String?
  reprise_auto        Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  inscription Inscription @relation(fields: [inscription_id], references: [id], onDelete: Cascade)

  @@index([inscription_id])
  @@map("inscriptions_historiques_scolaires")
}

model IdentifiantEleve {
  id         String    @id @default(uuid())
  eleve_id   String
  type       String // CIN, acte...
  valeur     String
  delivre_le DateTime?
  expire_le  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve Eleve @relation(fields: [eleve_id], references: [id])

  @@index([eleve_id])
  @@map("identifiants_eleves")
}

/**
 * =========================
 * 4) PERSONNEL
 * =========================
 */
model Personnel {
  id               String    @id @default(uuid())
  etablissement_id String
  code_personnel   String?
  utilisateur_id   String?
  date_embauche    DateTime?
  statut           String?
  poste            String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement      @relation(fields: [etablissement_id], references: [id])
  utilisateur   Utilisateur?       @relation(fields: [utilisateur_id], references: [id])
  enseignant    Enseignant?
  presences     PresencePersonnel[]
  Emprunt       Emprunt[]

  @@index([etablissement_id])
  @@map("personnel")
}

model Enseignant {
  id                       String  @id @default(uuid())
  personnel_id             String  @unique
  departement_principal_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  personnel   Personnel    @relation(fields: [personnel_id], references: [id])
  departement Departement? @relation(fields: [departement_principal_id], references: [id])

  cours              Cours[]
  evaluationsCreees  Evaluation[]    @relation("evaluations_createur")
  sessionsAppel      SessionAppel[]
  emploiDuTemps      EmploiDuTemps[]
  classesPrincipales Classe[]        @relation("classe_principal")

  @@map("enseignants")
}

model Departement {
  id               String @id @default(uuid())
  etablissement_id String
  nom              String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  matieres      Matiere[]
  enseignants   Enseignant[]

  @@index([etablissement_id])
  @@map("departements")
}

/**
 * =========================
 * 5) PEDAGOGIE
 * =========================
 */
model Matiere {
  id               String  @id @default(uuid())
  etablissement_id String
  code             String?
  nom              String
  departement_id   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement   Etablissement      @relation(fields: [etablissement_id], references: [id])
  departement     Departement?       @relation(fields: [departement_id], references: [id])
  cours           Cours[]
  lignesProgramme ProgrammeMatiere[]
  lignesBulletin  BulletinLigne[]
  pedagogicalItems PedagogicalItem[]
  EmploiDuTemps   EmploiDuTemps[]

  @@index([etablissement_id])
  @@map("matieres")
}

model PedagogicalItem {
  id                         String                     @id @default(uuid())
  etablissement_id           String
  annee_scolaire_id          String
  niveau_scolaire_id         String
  parent_id                  String?
  matiere_id                 String?
  grading_scale_id           String?
  item_type                  PedagogicalItemType
  code                       String?
  nom                        String
  description                String?
  display_order              Int                        @default(0)
  coefficient                Float?
  weight                     Float?
  is_evaluable               Boolean                    @default(false)
  is_visible_on_report       Boolean                    @default(true)
  is_required                Boolean                    @default(false)
  include_in_general_average Boolean                    @default(true)
  grading_mode_override      BulletinGradingMode?
  calculation_mode           PedagogicalCalculationMode @default(WEIGHTED_AVERAGE)
  is_active                  Boolean                    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement            Etablissement                    @relation(fields: [etablissement_id], references: [id])
  annee                    AnneeScolaire                    @relation(fields: [annee_scolaire_id], references: [id])
  niveau                   NiveauScolaire                   @relation(fields: [niveau_scolaire_id], references: [id])
  matiere                  Matiere?                         @relation(fields: [matiere_id], references: [id])
  gradingScale             GradingScale?                    @relation(fields: [grading_scale_id], references: [id])
  parent                   PedagogicalItem?                 @relation("pedagogical_item_tree", fields: [parent_id], references: [id])
  enfants                  PedagogicalItem[]                @relation("pedagogical_item_tree")
  evaluations              Evaluation[]
  reportCardTemplateItems  ReportCardTemplatePedagogicalItem[]
  calculatedAverages       PedagogicalItemAverage[]
  bulletinLignes           BulletinLigne[]

  @@unique([annee_scolaire_id, niveau_scolaire_id, parent_id, nom])
  @@index([etablissement_id])
  @@index([annee_scolaire_id, niveau_scolaire_id, item_type])
  @@index([parent_id, display_order])
  @@index([matiere_id])
  @@index([grading_scale_id], map: "pedagogical_items_grading_scale_id_idx")
  @@map("pedagogical_items")
}

model GradingScale {
  id                  String      @id @default(uuid())
  etablissement_id    String
  annee_scolaire_id   String
  nom                 String
  grading_type        GradingType
  base_score          Float?
  use_for_calculation Boolean     @default(true)
  allow_decimal       Boolean     @default(true)
  is_default          Boolean     @default(false)
  is_active           Boolean     @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement       @relation(fields: [etablissement_id], references: [id])
  annee         AnneeScolaire       @relation(fields: [annee_scolaire_id], references: [id])
  levels        GradingScaleLevel[]
  evaluations   Evaluation[]
  pedagogicalItems PedagogicalItem[]
  programmeDefaults Programme[] @relation("programme_default_grading_scale")
  programmeMatieres ProgrammeMatiere[] @relation("programme_matiere_grading_scale")

  @@unique([annee_scolaire_id, nom])
  @@index([etablissement_id])
  @@index([annee_scolaire_id, is_default])
  @@map("grading_scales")
}

model GradingScaleLevel {
  id               String  @id @default(uuid())
  grading_scale_id String
  code             String
  label            String
  numeric_value    Float?
  min_value        Float?
  max_value        Float?
  display_order    Int     @default(0)
  color            String?
  is_success_level Boolean @default(false)
  is_active        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  gradingScale GradingScale @relation(fields: [grading_scale_id], references: [id], onDelete: Cascade)
  assessmentResults AssessmentResult[]

  @@unique([grading_scale_id, code])
  @@index([grading_scale_id, display_order])
  @@map("grading_scale_levels")
}

model Programme {
  id                       String          @id @default(uuid())
  etablissement_id         String
  annee_scolaire_id        String
  niveau_scolaire_id       String
  code                     String?
  nom                      String
  description              String?         @db.Text
  statut                   StatutProgramme @default(DRAFT)
  date_debut               DateTime?
  date_fin                 DateTime?
  est_actif                Boolean         @default(false)
  ordre_affichage          Int             @default(0)
  default_grading_scale_id String?
  verrouille_le            DateTime?
  archive_le               DateTime?
  created_by_utilisateur_id String?
  updated_by_utilisateur_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement        Etablissement  @relation(fields: [etablissement_id], references: [id])
  annee                AnneeScolaire  @relation(fields: [annee_scolaire_id], references: [id])
  niveau               NiveauScolaire @relation(fields: [niveau_scolaire_id], references: [id])
  defaultGradingScale  GradingScale?  @relation("programme_default_grading_scale", fields: [default_grading_scale_id], references: [id], onDelete: SetNull)
  createdBy            Utilisateur?   @relation("programme_createur", fields: [created_by_utilisateur_id], references: [id], onDelete: SetNull)
  updatedBy            Utilisateur?   @relation("programme_modificateur", fields: [updated_by_utilisateur_id], references: [id], onDelete: SetNull)
  matieres             ProgrammeMatiere[]
  changeLogs           ProgrammeChangeLog[]

  @@index([annee_scolaire_id])
  @@index([niveau_scolaire_id], map: "programmes_niveau_scolaire_id_idx")
  @@index([etablissement_id, statut], map: "programmes_etablissement_id_statut_idx")
  @@unique([etablissement_id, annee_scolaire_id, niveau_scolaire_id, nom], map: "pro_etab_id_an_sco_id_niv_sco_id_nom_key")
  @@unique([etablissement_id, annee_scolaire_id, code], map: "programmes_etablissement_id_annee_scolaire_id_code_key")
  @@map("programmes")
}

model ProgrammeMatiere {
  id                         String                 @id @default(uuid())
  programme_id               String
  matiere_id                 String
  heures_semaine             Int?
  heures_annuelles           Int?
  seances_par_semaine        Int?
  duree_seance_par_defaut    Int?
  coefficient                Float?
  est_obligatoire            Boolean                @default(true)
  est_visible_bulletin       Boolean                @default(true)
  inclure_moyenne_generale   Boolean                @default(true)
  appreciation_obligatoire   Boolean                @default(false)
  libelle_bulletin           String?
  ordre_affichage_bulletin   Int?
  grading_scale_id           String?
  mode_calcul                PedagogicalCalculationMode @default(WEIGHTED_AVERAGE)
  statut                     StatutProgrammeMatiere @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  programme    Programme     @relation(fields: [programme_id], references: [id])
  matiere      Matiere       @relation(fields: [matiere_id], references: [id])
  gradingScale GradingScale? @relation("programme_matiere_grading_scale", fields: [grading_scale_id], references: [id], onDelete: SetNull)

  @@index([programme_id])
  @@index([matiere_id], map: "programmes_matieres_matiere_id_idx")
  @@unique([programme_id, matiere_id], map: "programmes_matieres_programme_id_matiere_id_key")
  @@map("programmes_matieres")
}

model ProgrammeChangeLog {
  id                       String   @id @default(uuid())
  programme_id             String
  entity_type              String
  entity_id                String?
  action                   String
  field_name               String?
  old_value_json           Json?
  new_value_json           Json?
  reason                   String?
  impact_summary_json      Json?
  changed_by_utilisateur_id String?
  changed_at               DateTime @default(now())

  programme Programme   @relation(fields: [programme_id], references: [id], onDelete: Cascade)
  changedBy Utilisateur? @relation("programme_change_log_actor", fields: [changed_by_utilisateur_id], references: [id], onDelete: SetNull)

  @@index([programme_id, changed_at], map: "programmes_change_logs_programme_id_changed_at_idx")
  @@index([changed_by_utilisateur_id], map: "programmes_change_logs_changed_by_utilisateur_id_idx")
  @@map("programmes_change_logs")
}

model Cours {
  id                   String @id @default(uuid())
  etablissement_id     String
  annee_scolaire_id    String
  classe_id            String
  matiere_id           String
  enseignant_id        String
  coefficient_override Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  annee         AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  classe        Classe        @relation(fields: [classe_id], references: [id])
  matiere       Matiere       @relation(fields: [matiere_id], references: [id])
  enseignant    Enseignant    @relation(fields: [enseignant_id], references: [id])

  evaluations   Evaluation[]
  emploiDuTemps EmploiDuTemps[]

  @@unique([classe_id, matiere_id, annee_scolaire_id])
  @@map("cours")
}

model TypeEvaluationRef {
  id               String @id @default(uuid())
  etablissement_id String
  code             TypeEvaluation @default(AUTRE)
  nom              String
  poids_defaut     Float?
  default_max_score Float?
  include_in_average Boolean @default(true)
  show_in_report_card Boolean @default(false)
  is_final_exam    Boolean @default(false)
  is_active        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  evaluations Evaluation[]

  @@index([etablissement_id])
  @@unique([etablissement_id, code])
  @@map("types_evaluations")
}

model Evaluation {
  id                     String         @id @default(uuid())
  cours_id               String
  periode_id             String
  pedagogical_item_id    String?
  grading_scale_id       String?
  type_evaluation_id     String?
  type                   TypeEvaluation @default(AUTRE)
  titre                  String
  description            String?
  date                   DateTime
  note_max               Float          @default(20)
  poids                  Float? // coefficient/poids
  est_publiee            Boolean        @default(false)
  include_in_average     Boolean        @default(true)
  show_in_report_card    Boolean        @default(false)
  is_final_exam          Boolean        @default(false)
  status                 AssessmentWorkflowStatus @default(DRAFT)
  cree_par_enseignant_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cours            Cours              @relation(fields: [cours_id], references: [id])
  periode          Periode            @relation(fields: [periode_id], references: [id])
  pedagogicalItem  PedagogicalItem?   @relation(fields: [pedagogical_item_id], references: [id])
  gradingScale     GradingScale?      @relation(fields: [grading_scale_id], references: [id])
  typeRef          TypeEvaluationRef? @relation(fields: [type_evaluation_id], references: [id])
  createur         Enseignant?        @relation("evaluations_createur", fields: [cree_par_enseignant_id], references: [id])

  notes             Note[]
  assessmentResults AssessmentResult[]

  @@index([cours_id])
  @@index([periode_id])
  @@index([pedagogical_item_id])
  @@index([grading_scale_id])
  @@map("evaluations")
}

model Note {
  id            String    @id @default(uuid())
  evaluation_id String
  eleve_id      String
  score         Float
  commentaire   String?
  note_le       DateTime?
  note_par      String? // id utilisateur/enseignant, simplifié

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  evaluation Evaluation @relation(fields: [evaluation_id], references: [id])
  eleve      Eleve      @relation(fields: [eleve_id], references: [id])

  @@unique([evaluation_id, eleve_id])
  @@map("notes")
}

model AssessmentResult {
  id                String                 @id @default(uuid())
  assessment_id     String
  student_id        String
  raw_score         Float?
  max_score         Float?
  normalized_score  Float?
  scale_level_id    String?
  text_value        String?
  display_value     String?
  status            AssessmentResultStatus @default(GRADED)
  observation       String?
  is_validated      Boolean                @default(false)
  validated_at      DateTime?
  validated_by      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assessment   Evaluation         @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  student      Eleve              @relation(fields: [student_id], references: [id], onDelete: Cascade)
  scaleLevel   GradingScaleLevel? @relation(fields: [scale_level_id], references: [id])
  history      AssessmentResultHistory[]

  @@unique([assessment_id, student_id])
  @@index([student_id])
  @@index([scale_level_id])
  @@map("assessment_results")
}

model AssessmentResultHistory {
  id                      String   @id @default(uuid())
  assessment_result_id    String
  old_raw_score           Float?
  new_raw_score           Float?
  old_max_score           Float?
  new_max_score           Float?
  old_normalized_score    Float?
  new_normalized_score    Float?
  old_scale_level_id      String?
  new_scale_level_id      String?
  old_text_value          String?
  new_text_value          String?
  old_display_value       String?
  new_display_value       String?
  old_status              AssessmentResultStatus?
  new_status              AssessmentResultStatus?
  reason                  String?
  changed_by              String?
  changed_at              DateTime @default(now())

  assessmentResult AssessmentResult @relation(fields: [assessment_result_id], references: [id], onDelete: Cascade)

  @@index([assessment_result_id, changed_at])
  @@map("assessment_result_history")
}

model PedagogicalItemAverage {
  id                  String                       @id @default(uuid())
  etablissement_id    String
  annee_scolaire_id   String
  periode_id          String
  classe_id           String
  eleve_id            String
  pedagogical_item_id String
  student_average     Float?
  class_average       Float?
  display_value       String?
  calculation_mode    ReportAverageCalculationMode @default(HIERARCHICAL)
  rounding_precision  Int                          @default(2)
  status              String?
  calculated_at       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement   Etablissement   @relation(fields: [etablissement_id], references: [id])
  annee           AnneeScolaire   @relation(fields: [annee_scolaire_id], references: [id])
  periode         Periode         @relation(fields: [periode_id], references: [id])
  classe          Classe          @relation(fields: [classe_id], references: [id])
  eleve           Eleve           @relation(fields: [eleve_id], references: [id], onDelete: Cascade)
  pedagogicalItem PedagogicalItem @relation(fields: [pedagogical_item_id], references: [id], onDelete: Cascade)

  @@unique([periode_id, classe_id, eleve_id, pedagogical_item_id], map: "p_i_a_periode_id_classe_id_eleve_id_pedagogical_item_id_key")
  @@index([etablissement_id], map: "pedagogical_item_averages_etablissement_id_idx")
  @@index([annee_scolaire_id, periode_id], map: "pedagogical_item_averages_annee_scolaire_id_periode_id_idx")
  @@index([classe_id, pedagogical_item_id], map: "pedagogical_item_averages_classe_id_pedagogical_item_id_idx")
  @@map("pedagogical_item_averages")
}

model RegleNote {
  id               String  @id @default(uuid())
  etablissement_id String
  scope            String? // tenant/class/matiere...
  regle_json       Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])

  @@index([etablissement_id])
  @@map("regles_notes")
}

model ReportCardTemplate {
  id                                     String                        @id @default(uuid())
  etablissement_id                       String
  annee_scolaire_id                      String
  niveau_scolaire_id                     String?
  nom                                    String
  description                            String?
  template_type                          ReportCardTemplateType        @default(STANDARD)
  pedagogical_display_mode               PedagogicalDisplayMode        @default(SUBJECTS_ONLY)
  calculation_mode                       ReportAverageCalculationMode  @default(HIERARCHICAL)
  include_code_grades_in_general_average Boolean                       @default(false)
  show_student_average                   Boolean                       @default(true)
  show_class_average                     Boolean                       @default(true)
  show_general_student_average           Boolean                       @default(true)
  show_general_class_average             Boolean                       @default(false)
  show_code_legend                       Boolean                       @default(false)
  show_section_headers                   Boolean                       @default(true)
  rounding_precision                     Int                           @default(2)
  show_assessment_details                Boolean                       @default(false)
  show_assessment_type_summary           Boolean                       @default(false)
  show_only_final_exam                   Boolean                       @default(false)
  show_subjects                          Boolean                       @default(true)
  show_groups                            Boolean                       @default(false)
  show_domains                           Boolean                       @default(false)
  show_subdomains                        Boolean                       @default(false)
  show_competencies                      Boolean                       @default(false)
  show_objectives                        Boolean                       @default(false)
  show_only_evaluated_items              Boolean                       @default(false)
  show_non_evaluated_items               Boolean                       @default(true)
  non_evaluated_label                    String                        @default("Non evalue")
  group_items_by_parent                  Boolean                       @default(true)
  show_hierarchical_indent               Boolean                       @default(true)
  max_hierarchy_depth                    Int                           @default(4)
  show_subject_summary                   Boolean                       @default(true)
  show_domain_summary                    Boolean                       @default(false)
  show_subdomain_summary                 Boolean                       @default(false)
  show_competency_results                Boolean                       @default(true)
  show_subject_average                   Boolean                       @default(true)
  show_subject_coefficient               Boolean                       @default(true)
  show_subject_points                    Boolean                       @default(false)
  show_subject_rank                      Boolean                       @default(true)
  show_teacher_appreciation              Boolean                       @default(true)
  show_general_average                   Boolean                       @default(true)
  show_total_coefficients                Boolean                       @default(true)
  show_total_points                      Boolean                       @default(false)
  show_general_rank                      Boolean                       @default(true)
  show_mention                           Boolean                       @default(true)
  show_decision                          Boolean                       @default(true)
  show_general_appreciation              Boolean                       @default(true)
  show_absences                          Boolean                       @default(false)
  show_late_count                        Boolean                       @default(false)
  show_logo                              Boolean                       @default(true)
  show_signature                         Boolean                       @default(true)
  is_default                             Boolean                       @default(false)
  is_active                              Boolean                       @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement     Etablissement                     @relation(fields: [etablissement_id], references: [id])
  annee             AnneeScolaire                     @relation(fields: [annee_scolaire_id], references: [id])
  niveau            NiveauScolaire?                   @relation(fields: [niveau_scolaire_id], references: [id])
  bulletins         Bulletin[]
  sections          ReportCardTemplateSection[]
  fields            ReportCardTemplateField[]
  pedagogicalItems  ReportCardTemplatePedagogicalItem[]

  @@unique([annee_scolaire_id, nom])
  @@index([etablissement_id])
  @@index([annee_scolaire_id, is_default])
  @@index([niveau_scolaire_id])
  @@map("modeles_bulletins")
}

model ReportCardTemplatePedagogicalItem {
  id                                  String  @id @default(uuid())
  template_id                         String
  section_id                          String?
  pedagogical_item_id                 String
  is_visible                          Boolean @default(true)
  custom_label                        String?
  display_order                       Int     @default(0)
  show_result                         Boolean @default(true)
  show_appreciation                   Boolean @default(false)
  show_children                       Boolean @default(true)
  grading_scale_id_override           String?
  include_in_general_average_override Boolean?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  template         ReportCardTemplate         @relation(fields: [template_id], references: [id])
  section          ReportCardTemplateSection? @relation(fields: [section_id], references: [id])
  pedagogicalItem  PedagogicalItem            @relation(fields: [pedagogical_item_id], references: [id])

  @@unique([template_id, pedagogical_item_id])
  @@index([template_id, is_visible, display_order])
  @@index([pedagogical_item_id])
  @@index([section_id], map: "modeles_bulletins_items_pedagogiques_section_id_idx")
  @@map("modeles_bulletins_items_pedagogiques")
}

model ReportCardTemplateSection {
  id                String                        @id @default(uuid())
  template_id       String
  parent_section_id String?
  title             String
  section_type      ReportCardTemplateSectionType @default(CUSTOM)
  grading_mode      BulletinGradingMode?         @default(NONE)
  display_order     Int                          @default(0)
  show_header       Boolean                      @default(true)
  is_active         Boolean                      @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  template              ReportCardTemplate                  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  parentSection         ReportCardTemplateSection?          @relation("report_card_template_section_tree", fields: [parent_section_id], references: [id])
  childSections         ReportCardTemplateSection[]         @relation("report_card_template_section_tree")
  fields                ReportCardTemplateField[]
  pedagogicalSelections ReportCardTemplatePedagogicalItem[]

  @@unique([template_id, parent_section_id, title], map: "m_b_s_template_id_parent_section_id_title_key")
  @@index([template_id, display_order], map: "modeles_bulletins_sections_template_id_display_order_idx")
  @@index([parent_section_id, display_order], map: "modeles_bulletins_sections_parent_section_id_display_order_idx")
  @@map("modeles_bulletins_sections")
}

model ReportCardTemplateField {
  id            String  @id @default(uuid())
  template_id   String
  section_id    String
  field_key     String
  label         String
  display_order Int     @default(0)
  is_visible    Boolean @default(true)
  width         Int?
  alignment     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  template ReportCardTemplate        @relation(fields: [template_id], references: [id], onDelete: Cascade)
  section  ReportCardTemplateSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([template_id, section_id, field_key], map: "m_b_f_template_id_section_id_field_key_key")
  @@index([template_id, display_order], map: "modeles_bulletins_fields_template_id_display_order_idx")
  @@index([section_id, display_order], map: "modeles_bulletins_fields_section_id_display_order_idx")
  @@map("modeles_bulletins_fields")
}

model Bulletin {
  id                      String    @id @default(uuid())
  eleve_id                String
  periode_id              String
  classe_id               String
  report_card_template_id String?
  validated_at            DateTime?
  validated_by            String?
  publie_le               DateTime?
  statut                  String?
  general_average         Decimal?  @db.Decimal(5, 2)
  general_class_average   Decimal?  @db.Decimal(5, 2)
  total_coefficients      Decimal?  @db.Decimal(8, 2)
  total_points            Decimal?  @db.Decimal(8, 2)
  general_rank            Int?
  mention                 String?
  decision                String?
  general_appreciation    String?
  display_snapshot_json   Json?
  display_legend_json     Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve              Eleve               @relation(fields: [eleve_id], references: [id])
  periode            Periode             @relation(fields: [periode_id], references: [id])
  classe             Classe              @relation(fields: [classe_id], references: [id])
  reportCardTemplate ReportCardTemplate? @relation(fields: [report_card_template_id], references: [id])
  lignes             BulletinLigne[]
  codeLegends        BulletinCodeLegend[]

  @@index([eleve_id])
  @@index([periode_id])
  @@index([report_card_template_id])
  @@unique([eleve_id, periode_id])
  @@map("bulletins")
}

model BulletinLigne {
  id                     String               @id @default(uuid())
  bulletin_id            String
  matiere_id             String
  parent_ligne_id        String?
  pedagogical_item_id    String?
  item_type              PedagogicalItemType?
  grading_mode           BulletinGradingMode? @default(NONE)
  moyenne                Float?
  display_value          String?
  numeric_value          Float?
  student_average        Float?
  class_average          Float?
  scale_level_id         String?
  observation            String?              @db.Text
  rang                   Int?
  commentaire_enseignant String?
  display_order          Int                  @default(0)
  is_visible             Boolean              @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bulletin        Bulletin        @relation(fields: [bulletin_id], references: [id])
  matiere         Matiere         @relation(fields: [matiere_id], references: [id])
  parentLigne     BulletinLigne?  @relation("bulletin_ligne_tree", fields: [parent_ligne_id], references: [id])
  childLignes     BulletinLigne[] @relation("bulletin_ligne_tree")
  pedagogicalItem PedagogicalItem? @relation(fields: [pedagogical_item_id], references: [id])
  details         BulletinLigneDetail[]

  @@index([bulletin_id])
  @@index([parent_ligne_id, display_order], map: "bulletins_lignes_parent_ligne_id_display_order_idx")
  @@index([pedagogical_item_id], map: "bulletins_lignes_pedagogical_item_id_idx")
  @@unique([bulletin_id, pedagogical_item_id], map: "bulletins_lignes_bulletin_id_pedagogical_item_id_key")
  @@map("bulletins_lignes")
}

model BulletinLigneDetail {
  id                   String  @id @default(uuid())
  bulletin_ligne_id    String
  assessment_id        String?
  assessment_result_id String?
  label                String
  display_value        String?
  numeric_value        Float?
  scale_level_id       String?
  display_order        Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bulletinLigne BulletinLigne @relation(fields: [bulletin_ligne_id], references: [id], onDelete: Cascade)

  @@index([bulletin_ligne_id, display_order], map: "b_l_details_bulletin_ligne_id_display_order_idx")
  @@map("bulletins_lignes_details")
}

model BulletinCodeLegend {
  id               String  @id @default(uuid())
  bulletin_id      String
  grading_scale_id String?
  code             String
  label            String
  numeric_value    Float?
  display_order    Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bulletin Bulletin @relation(fields: [bulletin_id], references: [id], onDelete: Cascade)

  @@unique([bulletin_id, code], map: "bulletins_codes_legendes_bulletin_id_code_key")
  @@index([bulletin_id, display_order], map: "bulletins_codes_legendes_bulletin_id_display_order_idx")
  @@map("bulletins_codes_legendes")
}

/**
 * =========================
 * 6) TEMPS & PLANNING
 * =========================
 */
model CreneauHoraire {
  id               String @id @default(uuid())
  etablissement_id String
  nom              String
  heure_debut      String // "08:00"
  heure_fin        String // "09:00"
  ordre            Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  emploiDuTemps EmploiDuTemps[]
  sessionsAppel SessionAppel[]

  @@index([etablissement_id])
  @@map("creneaux_horaires")
}

model EmploiDuTemps {
  id                 String    @id @default(uuid())
  classe_id          String
  cours_id           String?
  matiere_id         String?
  enseignant_id      String?
  salle_id           String?
  jour_semaine       Int // 1-7
  heure_debut        String // "08:30"
  heure_fin          String // "11:30"
  creneau_horaire_id String?
  effectif_du        DateTime?
  effectif_au        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  classe     Classe         @relation(fields: [classe_id], references: [id])
  cours      Cours?         @relation(fields: [cours_id], references: [id])
  matiere    Matiere?       @relation(fields: [matiere_id], references: [id])
  enseignant Enseignant?    @relation(fields: [enseignant_id], references: [id])
  salle      Salle?         @relation(fields: [salle_id], references: [id])
  creneau    CreneauHoraire? @relation(fields: [creneau_horaire_id], references: [id])
  sessionsAppel SessionAppel[]

  @@index([classe_id])
  @@map("emploi_du_temps")
}

model EvenementCalendrier {
  id               String   @id @default(uuid())
  etablissement_id String
  site_id          String?
  titre            String
  debut            DateTime
  fin              DateTime
  type             String?
  description      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  site          Site?         @relation(fields: [site_id], references: [id])

  @@index([etablissement_id])
  @@map("evenements_calendrier")
}

/**
 * =========================
 * 7) PRESENCES
 * =========================
 */
model SessionAppel {
  id                     String    @id @default(uuid())
  classe_id              String
  emploi_du_temps_id     String?
  date                   DateTime
  creneau_horaire_id     String
  pris_par_enseignant_id String?
  pris_le                DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  classe  Classe         @relation(fields: [classe_id], references: [id])
  emploi  EmploiDuTemps? @relation(fields: [emploi_du_temps_id], references: [id])
  creneau CreneauHoraire @relation(fields: [creneau_horaire_id], references: [id])
  prisPar Enseignant?    @relation(fields: [pris_par_enseignant_id], references: [id])

  presences PresenceEleve[]

  @@index([classe_id])
  @@index([emploi_du_temps_id])
  @@index([date])
  @@unique([emploi_du_temps_id, date])
  @@unique([classe_id, date, creneau_horaire_id])
  @@map("sessions_appel")
}

model PresenceEleve {
  id               String         @id @default(uuid())
  session_appel_id String
  eleve_id         String
  statut           StatutPresence
  minutes_retard   Int?
  note             String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  session SessionAppel @relation(fields: [session_appel_id], references: [id])
  eleve   Eleve        @relation(fields: [eleve_id], references: [id])

  @@unique([session_appel_id, eleve_id])
  @@map("presences_eleves")
}

model MotifAbsence {
  id                    String  @id @default(uuid())
  etablissement_id      String
  nom                   String
  est_excuse_par_defaut Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  justificatifs JustificatifAbsence[]

  @@index([etablissement_id])
  @@unique([etablissement_id, nom])
  @@map("motifs_absence")
}

model JustificatifAbsence {
  id               String    @id @default(uuid())
  eleve_id         String
  date_debut       DateTime
  date_fin         DateTime
  motif_absence_id String?
  document_url     String?
  approuve_par     String? // id utilisateur
  approuve_le      DateTime?
  statut           String? // EN_ATTENTE / APPROUVE / REFUSE

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve Eleve         @relation(fields: [eleve_id], references: [id])
  motif MotifAbsence? @relation(fields: [motif_absence_id], references: [id])

  @@index([eleve_id])
  @@map("justificatifs_absence")
}

model PresencePersonnel {
  id           String   @id @default(uuid())
  personnel_id String
  date         DateTime
  statut       String?
  note         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  personnel Personnel @relation(fields: [personnel_id], references: [id])

  @@unique([personnel_id, date])
  @@index([date])
  @@map("presences_personnel")
}

/**
 * =========================
 * 8) DISCIPLINE
 * =========================
 */
model IncidentDisciplinaire {
  id          String   @id @default(uuid())
  eleve_id    String
  date        DateTime
  signale_par String? // id utilisateur
  description String
  gravite     Int?
  statut      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve     Eleve                   @relation(fields: [eleve_id], references: [id])
  sanctions SanctionDisciplinaire[]

  @@index([eleve_id])
  @@map("incidents_disciplinaires")
}

model SanctionDisciplinaire {
  id          String    @id @default(uuid())
  incident_id String
  type_action String // avertissement, retenue...
  debut       DateTime?
  fin         DateTime?
  notes       String?
  decide_par  String? // id utilisateur

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  incident IncidentDisciplinaire @relation(fields: [incident_id], references: [id])

  @@index([incident_id])
  @@map("sanctions_disciplinaires")
}

model Recompense {
  id        String   @id @default(uuid())
  eleve_id  String
  date      DateTime
  points    Int?     @default(0)
  raison    String?
  donne_par String? // id utilisateur

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve Eleve @relation(fields: [eleve_id], references: [id])

  @@index([eleve_id])
  @@map("recompenses")
}

/**
 * =========================
 * 9) COMMUNICATION
 * =========================
 */
model CanalCommunication {
  id               String    @id @default(uuid())
  etablissement_id String
  type             TypeCanal
  nom              String
  config_json      Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])

  @@index([etablissement_id])
  @@map("canaux_communication")
}

model Annonce {
  id               String    @id @default(uuid())
  etablissement_id String
  titre            String
  contenu          String
  publie_le        DateTime?
  cree_par         String? // id utilisateur
  cible_json       Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])

  @@index([etablissement_id])
  @@map("annonces")
}

model Message {
  id                        String    @id @default(uuid())
  etablissement_id          String
  expediteur_utilisateur_id String
  objet                     String?
  corps                     String
  envoye_le                 DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement         @relation(fields: [etablissement_id], references: [id])
  expediteur    Utilisateur           @relation("messages_envoyes", fields: [expediteur_utilisateur_id], references: [id])
  destinataires MessageDestinataire[]

  @@index([etablissement_id])
  @@map("messages")
}

model MessageDestinataire {
  message_id     String
  utilisateur_id String
  statut         String? // sent/read
  lu_le          DateTime?

  message     Message     @relation(fields: [message_id], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@id([message_id, utilisateur_id])
  @@map("messages_destinataires")
}

model Notification {
  id             String    @id @default(uuid())
  utilisateur_id String
  type           String
  payload_json   Json?
  lu_le          DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id])
  @@map("notifications")
}

/**
 * =========================
 * 10) FINANCE
 * =========================
 */
model CatalogueFrais {
  id                 String  @id @default(uuid())
  etablissement_id   String
  niveau_scolaire_id String?
  usage_scope        String  @default("GENERAL")
  nom                String
  description        String?
  montant            Decimal @db.Decimal(12, 2)
  devise             String  @default("MGA")
  nombre_tranches    Int     @default(1)
  mode_facturation   String  @default("PONCTUEL")
  est_recurrent      Boolean @default(false)
  periodicite        String? // monthly/term/year
  prorata_eligible   Boolean @default(false)
  eligibilite_json   Json?
  plans_paiement_autorises_json Json?
  plan_paiement_defaut_code String?
  statut_validation  String  @default("EN_ATTENTE")
  approuve_par_utilisateur_id String?
  approuve_le        DateTime?
  motif_rejet        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement  @relation(fields: [etablissement_id], references: [id])
  niveau        NiveauScolaire? @relation(fields: [niveau_scolaire_id], references: [id])
  approbateur   Utilisateur? @relation("catalogue_frais_approbateur", fields: [approuve_par_utilisateur_id], references: [id])
  lignesFacture FactureLigne[]
  lignesTransport LigneTransport[]
  formulesCantine FormuleCantine[]
  executionsRecurrentes FacturationRecurrenteExecution[]

  @@index([etablissement_id, niveau_scolaire_id], map: "idx_catfrais_etab_niveau")
  @@index([statut_validation], map: "idx_catfrais_statut_validation")
  @@index([approuve_par_utilisateur_id], map: "idx_catfrais_approbateur")
  @@unique([etablissement_id, niveau_scolaire_id, nom], map: "uq_catfrais_etab_niveau_nom")
  @@map("catalogue_frais")
}

model PlanPaiementEleve {
  id                String @id @default(uuid())
  eleve_id          String
  annee_scolaire_id String
  remise_id         String?
  plan_json         Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve     Eleve              @relation(fields: [eleve_id], references: [id])
  annee     AnneeScolaire      @relation(fields: [annee_scolaire_id], references: [id])
  remise    Remise?            @relation(fields: [remise_id], references: [id])
  echeances EcheancePaiement[]
  promessesPaiement PromessePaiement[]
  restrictionsAdministratives RestrictionAdministrative[]
  dossiersRecouvrement DossierRecouvrement[]

  @@index([eleve_id])
  @@index([remise_id], map: "idx_plan_remise")
  @@map("plans_paiement_eleves")
}

model FacturationRecurrenteExecution {
  id                        String   @id @default(uuid())
  run_id                    String
  etablissement_id          String
  catalogue_frais_id        String
  eleve_id                  String
  annee_scolaire_id         String
  facture_id                String
  created_by_utilisateur_id String?
  periodicite               String
  cycle_key                 String
  cycle_label               String
  date_reference            DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  catalogueFrais CatalogueFrais @relation(fields: [catalogue_frais_id], references: [id])
  eleve Eleve @relation(fields: [eleve_id], references: [id])
  annee AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  facture Facture @relation(fields: [facture_id], references: [id], onDelete: Cascade)
  createur Utilisateur? @relation("facturation_recurrente_createur", fields: [created_by_utilisateur_id], references: [id])

  @@index([etablissement_id, date_reference], map: "idx_factrec_etab_date")
  @@index([catalogue_frais_id, cycle_key], map: "idx_factrec_catalogue_cycle")
  @@index([eleve_id, annee_scolaire_id], map: "idx_factrec_eleve_annee")
  @@index([run_id], map: "idx_factrec_run")
  @@unique([catalogue_frais_id, eleve_id, annee_scolaire_id, cycle_key], map: "uq_factrec_cat_eleve_cycle")
  @@map("facturations_recurrentes")
}

model Facture {
  id                String        @id @default(uuid())
  etablissement_id  String
  eleve_id          String
  annee_scolaire_id String
  remise_id         String?
  facture_origine_id String?
  nature            String        @default("FACTURE")
  numero_facture    String
  date_emission     DateTime      @default(now())
  date_echeance     DateTime?
  statut            StatutFacture @default(EMISE)
  total_montant     Decimal       @db.Decimal(12, 2)
  devise            String        @default("MGA")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement  @relation(fields: [etablissement_id], references: [id])
  eleve         Eleve          @relation(fields: [eleve_id], references: [id])
  annee         AnneeScolaire  @relation(fields: [annee_scolaire_id], references: [id])
  remise        Remise?        @relation(fields: [remise_id], references: [id])
  factureOrigine Facture?      @relation("facture_avoirs", fields: [facture_origine_id], references: [id])
  avoirs        Facture[]      @relation("facture_avoirs")
  lignes        FactureLigne[]
  paiements     Paiement[]
  echeances     EcheancePaiement[]
  abonnementsTransport AbonnementTransport[]
  abonnementsCantine AbonnementCantine[]
  executionsRecurrentes FacturationRecurrenteExecution[]
  operationsFinancieres OperationFinanciere[]
  promessesPaiement PromessePaiement[]
  restrictionsAdministratives RestrictionAdministrative[]
  dossiersRecouvrement DossierRecouvrement[]

  @@unique([etablissement_id, numero_facture])
  @@index([etablissement_id])
  @@index([remise_id], map: "idx_facture_remise")
  @@index([facture_origine_id], map: "idx_facture_origine")
  @@map("factures")
}

model FactureLigne {
  id                 String  @id @default(uuid())
  facture_id         String
  catalogue_frais_id String?
  libelle            String
  quantite           Int     @default(1)
  prix_unitaire      Decimal @db.Decimal(12, 2)
  montant            Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  facture Facture         @relation(fields: [facture_id], references: [id])
  frais   CatalogueFrais? @relation(fields: [catalogue_frais_id], references: [id])

  @@index([facture_id])
  @@map("factures_lignes")
}

model Paiement {
  id         String   @id @default(uuid())
  facture_id String
  paye_le    DateTime @default(now())
  montant    Decimal  @db.Decimal(12, 2)
  statut     String   @default("ENREGISTRE")
  methode    String? // cash/bank/mobile/card
  numero_recu String?
  reference  String?
  payeur_type String?
  payeur_nom String?
  payeur_reference String?
  recu_par   String? // id utilisateur

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  facture      Facture                       @relation(fields: [facture_id], references: [id])
  affectations PaiementEcheanceAffectation[]
  operationsFinancieres OperationFinanciere[]

  @@index([facture_id])
  @@map("paiements")
}

model OperationFinanciere {
  id                     String   @id @default(uuid())
  etablissement_id       String
  facture_id             String?
  paiement_id            String?
  abonnement_cantine_id  String?
  cree_par_utilisateur_id String?
  type                   String
  montant                Decimal? @db.Decimal(12, 2)
  motif                  String?
  details_json           Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  facture Facture? @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  paiement Paiement? @relation(fields: [paiement_id], references: [id], onDelete: SetNull)
  abonnementCantine AbonnementCantine? @relation(fields: [abonnement_cantine_id], references: [id], onDelete: SetNull)
  createur Utilisateur? @relation("operations_financieres_createur", fields: [cree_par_utilisateur_id], references: [id])

  @@index([etablissement_id, type], map: "idx_opfin_etab_type")
  @@index([facture_id], map: "idx_opfin_facture")
  @@index([paiement_id], map: "idx_opfin_paiement")
  @@index([abonnement_cantine_id], map: "idx_opfin_abonnement_cantine")
  @@map("operations_financieres")
}

model EcheancePaiement {
  id                String                 @id @default(uuid())
  plan_paiement_id  String?
  facture_id        String?
  eleve_id          String
  annee_scolaire_id String
  ordre             Int
  libelle           String?
  date_echeance     DateTime
  montant_prevu     Decimal                @db.Decimal(12, 2)
  montant_regle     Decimal                @default(0) @db.Decimal(12, 2)
  montant_restant   Decimal                @db.Decimal(12, 2)
  statut            StatutEcheancePaiement @default(A_VENIR)
  devise            String                 @default("MGA")
  notes             String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  planPaiement PlanPaiementEleve?           @relation(fields: [plan_paiement_id], references: [id], onDelete: SetNull)
  facture      Facture?                     @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  eleve        Eleve                        @relation(fields: [eleve_id], references: [id])
  annee        AnneeScolaire                @relation(fields: [annee_scolaire_id], references: [id])
  affectations PaiementEcheanceAffectation[]
  promessesPaiement PromessePaiement[]

  @@index([plan_paiement_id], map: "idx_ech_plan")
  @@index([facture_id], map: "idx_ech_fact")
  @@index([eleve_id, annee_scolaire_id], map: "idx_ech_eleve_annee")
  @@index([date_echeance, statut], map: "idx_ech_date_statut")
  @@unique([plan_paiement_id, ordre], map: "uq_ech_plan_ordre")
  @@unique([facture_id, ordre], map: "uq_ech_fact_ordre")
  @@map("echeances_paiement")
}

model PaiementEcheanceAffectation {
  id                   String  @id @default(uuid())
  paiement_id          String
  echeance_paiement_id String
  montant              Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  paiement Paiement         @relation(fields: [paiement_id], references: [id], onDelete: Cascade)
  echeance EcheancePaiement @relation(fields: [echeance_paiement_id], references: [id], onDelete: Cascade)

  @@unique([paiement_id, echeance_paiement_id], map: "uq_aff_paie_ech")
  @@index([echeance_paiement_id], map: "idx_aff_ech")
  @@map("paiements_echeances_affectations")
}

model Remise {
  id               String @id @default(uuid())
  etablissement_id String
  nom              String
  type             String // percent/fixed
  valeur           Float
  regles_json      Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  factures      Facture[]
  plansPaiement PlanPaiementEleve[]

  @@index([etablissement_id])
  @@map("remises")
}

model RegleRecouvrementFinance {
  id               String  @id @default(uuid())
  etablissement_id String
  nom              String  @default("Regle de recouvrement par defaut")
  jours_grace      Int     @default(0)
  relance_jours_json Json?
  penalite_active  Boolean @default(false)
  penalite_mode    String?
  penalite_valeur  Decimal? @db.Decimal(12, 2)
  statut_validation String @default("EN_ATTENTE")
  approuve_par_utilisateur_id String?
  approuve_le      DateTime?
  motif_rejet      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  approbateur Utilisateur? @relation("regle_recouvrement_approbateur", fields: [approuve_par_utilisateur_id], references: [id])

  @@unique([etablissement_id], map: "uq_regle_recouvrement_etab")
  @@index([statut_validation], map: "idx_regle_recouvrement_statut")
  @@index([approuve_par_utilisateur_id], map: "idx_regle_recouvrement_approbateur")
  @@map("regles_recouvrement_finance")
}

model PromessePaiement {
  id                    String                 @id @default(uuid())
  etablissement_id      String
  eleve_id              String
  annee_scolaire_id     String
  facture_id            String?
  plan_paiement_id      String?
  echeance_paiement_id  String?
  montant_promis        Decimal                @db.Decimal(12, 2)
  date_promesse         DateTime               @default(now())
  date_limite           DateTime
  statut                StatutPromessePaiement @default(EN_ATTENTE)
  canal                 String?
  note                  String?
  tenue_le              DateTime?
  rompue_le             DateTime?
  annulee_le            DateTime?
  cree_par_utilisateur_id String?
  valide_par_utilisateur_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  eleve Eleve @relation(fields: [eleve_id], references: [id])
  annee AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  facture Facture? @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  planPaiement PlanPaiementEleve? @relation(fields: [plan_paiement_id], references: [id], onDelete: SetNull)
  echeance EcheancePaiement? @relation(fields: [echeance_paiement_id], references: [id], onDelete: SetNull)
  createur Utilisateur? @relation("promesse_paiement_createur", fields: [cree_par_utilisateur_id], references: [id])
  validateur Utilisateur? @relation("promesse_paiement_validateur", fields: [valide_par_utilisateur_id], references: [id])

  @@index([etablissement_id, statut], map: "idx_promesse_etab_statut")
  @@index([eleve_id, annee_scolaire_id], map: "idx_promesse_eleve_annee")
  @@index([facture_id], map: "idx_promesse_facture")
  @@index([plan_paiement_id], map: "idx_promesse_plan")
  @@index([echeance_paiement_id], map: "idx_promesse_echeance")
  @@map("promesses_paiement")
}

model RestrictionAdministrative {
  id                    String                          @id @default(uuid())
  etablissement_id      String
  eleve_id              String
  annee_scolaire_id     String
  facture_id            String?
  plan_paiement_id      String?
  type                  TypeRestrictionAdministrative
  statut                StatutRestrictionAdministrative @default(ACTIVE)
  source                String? @default("MANUEL")
  motif                 String?
  date_activation       DateTime                        @default(now())
  date_levee            DateTime?
  cree_par_utilisateur_id String?
  levee_par_utilisateur_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  eleve Eleve @relation(fields: [eleve_id], references: [id])
  annee AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  facture Facture? @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  planPaiement PlanPaiementEleve? @relation(fields: [plan_paiement_id], references: [id], onDelete: SetNull)
  createur Utilisateur? @relation("restriction_admin_createur", fields: [cree_par_utilisateur_id], references: [id])
  leveur Utilisateur? @relation("restriction_admin_leveur", fields: [levee_par_utilisateur_id], references: [id])

  @@index([etablissement_id, statut], map: "idx_restriction_etab_statut")
  @@index([eleve_id, annee_scolaire_id], map: "idx_restriction_eleve_annee")
  @@index([facture_id], map: "idx_restriction_facture")
  @@index([plan_paiement_id], map: "idx_restriction_plan")
  @@map("restrictions_administratives")
}

model DossierRecouvrement {
  id                    String                    @id @default(uuid())
  etablissement_id      String
  eleve_id              String
  annee_scolaire_id     String
  facture_id            String?
  plan_paiement_id      String?
  statut                StatutDossierRecouvrement @default(OUVERT)
  motif                 String?
  note                  String?
  montant_reference     Decimal? @db.Decimal(12, 2)
  date_statut           DateTime @default(now())
  cree_par_utilisateur_id String?
  valide_par_utilisateur_id String?
  valide_le             DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  eleve Eleve @relation(fields: [eleve_id], references: [id])
  annee AnneeScolaire @relation(fields: [annee_scolaire_id], references: [id])
  facture Facture? @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  planPaiement PlanPaiementEleve? @relation(fields: [plan_paiement_id], references: [id], onDelete: SetNull)
  createur Utilisateur? @relation("dossier_recouvrement_createur", fields: [cree_par_utilisateur_id], references: [id])
  validateur Utilisateur? @relation("dossier_recouvrement_validateur", fields: [valide_par_utilisateur_id], references: [id])

  @@index([etablissement_id, statut], map: "idx_dossier_recouvrement_etab_statut")
  @@index([eleve_id, annee_scolaire_id], map: "idx_dossier_recouvrement_eleve_annee")
  @@index([facture_id], map: "idx_dossier_recouvrement_facture")
  @@index([plan_paiement_id], map: "idx_dossier_recouvrement_plan")
  @@map("dossiers_recouvrement")
}

/**
 * =========================
 * 11) BIBLIOTHEQUE
 * =========================
 */
model RessourceBibliotheque {
  id               String  @id @default(uuid())
  etablissement_id String
  type             String // livre/materiel
  titre            String
  code             String?
  auteur           String?
  editeur          String?
  annee            Int?
  stock            Int?    @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  emprunts Emprunt[]

  @@index([etablissement_id])
  @@map("ressources_bibliotheque")
}

model Emprunt {
  id                        String    @id @default(uuid())
  ressource_bibliotheque_id String
  eleve_id                  String?
  personnel_id              String?
  emprunte_le               DateTime  @default(now())
  du_le                     DateTime?
  retourne_le               DateTime?
  statut                    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ressource RessourceBibliotheque @relation(fields: [ressource_bibliotheque_id], references: [id])
  eleve     Eleve?                @relation(fields: [eleve_id], references: [id])
  personnel Personnel?            @relation(fields: [personnel_id], references: [id])

  @@index([ressource_bibliotheque_id])
  @@map("emprunts")
}

/**
 * =========================
 * 12) TRANSPORT / CANTINE
 * =========================
 */
model LigneTransport {
  id                  String @id @default(uuid())
  etablissement_id    String
  nom                 String
  catalogue_frais_id  String?
  infos_vehicule_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  frais       CatalogueFrais? @relation(fields: [catalogue_frais_id], references: [id], onDelete: SetNull)
  arrets      ArretTransport[]
  abonnements AbonnementTransport[]

  @@index([etablissement_id])
  @@index([catalogue_frais_id], map: "idx_lignetransport_frais")
  @@map("lignes_transport")
}

model ArretTransport {
  id                 String @id @default(uuid())
  ligne_transport_id String
  nom                String
  geo_json           Json?
  ordre              Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ligne               LigneTransport        @relation(fields: [ligne_transport_id], references: [id])
  AbonnementTransport AbonnementTransport[]

  @@index([ligne_transport_id])
  @@map("arrets_transport")
}

model AbonnementTransport {
  id                 String  @id @default(uuid())
  eleve_id           String
  annee_scolaire_id  String
  ligne_transport_id String
  arret_transport_id String?
  zone_transport     String?
  facture_id         String?
  a_facturer         Boolean @default(false)
  statut             String?
  date_debut_service DateTime?
  date_fin_service   DateTime?
  prorata_ratio      Decimal? @db.Decimal(8, 4)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve Eleve           @relation(fields: [eleve_id], references: [id])
  annee AnneeScolaire   @relation(fields: [annee_scolaire_id], references: [id])
  ligne LigneTransport  @relation(fields: [ligne_transport_id], references: [id])
  arret ArretTransport? @relation(fields: [arret_transport_id], references: [id])
  facture Facture?      @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  historiquesAffectation HistoriqueAffectationTransport[]

  @@index([eleve_id])
  @@index([facture_id], map: "idx_abt_facture")
  @@map("abonnements_transport")
}

model HistoriqueAffectationTransport {
  id                         String   @id @default(uuid())
  abonnement_transport_id    String
  ancienne_ligne_transport_id String
  ancien_arret_transport_id  String?
  ancienne_zone_transport    String?
  nouvelle_ligne_transport_id String
  nouvel_arret_transport_id  String?
  nouvelle_zone_transport    String?
  date_effet                 DateTime
  impact_tarifaire           Boolean  @default(false)
  ancien_statut              String?
  nouveau_statut             String?
  details_json               Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  abonnementTransport AbonnementTransport @relation(fields: [abonnement_transport_id], references: [id])

  @@index([abonnement_transport_id])
  @@map("historiques_affectation_transport")
}

model FormuleCantine {
  id               String  @id @default(uuid())
  etablissement_id String
  nom              String
  type_formule     String  @default("AUTRE")
  catalogue_frais_id String?
  transmettre_consommations_finance Boolean @default(true)
  max_repas_par_jour Int @default(1)
  regulariser_absence_annulation Boolean @default(false)
  mode_regularisation_absence String @default("AVOIR")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  abonnements AbonnementCantine[]
  frais       CatalogueFrais? @relation(fields: [catalogue_frais_id], references: [id], onDelete: SetNull)
  historiquesAncienneFormule HistoriqueFormuleCantine[] @relation("historique_formule_cantine_ancienne")
  historiquesNouvelleFormule HistoriqueFormuleCantine[] @relation("historique_formule_cantine_nouvelle")

  @@index([etablissement_id])
  @@index([catalogue_frais_id], map: "idx_formulecantine_frais")
  @@map("formules_cantine")
}

model AbonnementCantine {
  id                 String  @id @default(uuid())
  eleve_id           String
  annee_scolaire_id  String
  formule_cantine_id String
  facture_id         String?
  statut             String?
  date_effet         DateTime?
  solde_prepaye      Decimal @default(0) @db.Decimal(12, 2)
  solde_min_alerte   Decimal @default(0) @db.Decimal(12, 2)
  dernier_rechargement_le DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  eleve   Eleve          @relation(fields: [eleve_id], references: [id])
  annee   AnneeScolaire  @relation(fields: [annee_scolaire_id], references: [id])
  formule FormuleCantine @relation(fields: [formule_cantine_id], references: [id])
  facture Facture?       @relation(fields: [facture_id], references: [id], onDelete: SetNull)
  operationsFinancieres OperationFinanciere[]
  historiquesFormule HistoriqueFormuleCantine[]
  consommations      ConsommationCantine[]
  absences           AbsenceCantine[]

  @@index([eleve_id])
  @@index([facture_id], map: "idx_abc_facture")
  @@map("abonnements_cantine")
}

model HistoriqueFormuleCantine {
  id                        String   @id @default(uuid())
  abonnement_cantine_id     String
  ancienne_formule_cantine_id String
  nouvelle_formule_cantine_id String
  date_effet                DateTime
  impact_tarifaire          Boolean  @default(false)
  ancien_statut             String?
  nouveau_statut            String?
  details_json              Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  abonnement      AbonnementCantine @relation(fields: [abonnement_cantine_id], references: [id])
  ancienneFormule FormuleCantine @relation("historique_formule_cantine_ancienne", fields: [ancienne_formule_cantine_id], references: [id])
  nouvelleFormule FormuleCantine @relation("historique_formule_cantine_nouvelle", fields: [nouvelle_formule_cantine_id], references: [id])

  @@index([abonnement_cantine_id], map: "idx_histformcant_abonnement")
  @@index([ancienne_formule_cantine_id], map: "idx_histformcant_ancienne")
  @@index([nouvelle_formule_cantine_id], map: "idx_histformcant_nouvelle")
  @@map("historiques_formule_cantine")
}

model ConsommationCantine {
  id                      String   @id @default(uuid())
  abonnement_cantine_id   String
  type_repas              String   @default("repas")
  note                    String?
  consommation_le         DateTime
  statut_acces            String
  motif_acces             String?
  finance_status_snapshot String?
  transmission_finance    Boolean  @default(true)
  finance_processed_at    DateTime?
  details_json            Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  abonnement AbonnementCantine @relation(fields: [abonnement_cantine_id], references: [id])

  @@index([abonnement_cantine_id], map: "idx_conscant_abonnement")
  @@index([consommation_le], map: "idx_conscant_le")
  @@index([finance_processed_at], map: "idx_conscant_finance_processed")
  @@map("consommations_cantine")
}

model AbsenceCantine {
  id                         String   @id @default(uuid())
  abonnement_cantine_id      String
  type_evenement             String   @default("ABSENCE")
  date_repas                 DateTime
  etat_metier                String   @default("SIGNALEE")
  note                       String?
  statut_acces_snapshot      String?
  finance_status_snapshot    String?
  ouvre_droit_regularisation Boolean  @default(false)
  mode_regularisation_suggere String?
  transmission_finance       Boolean  @default(false)
  finance_processed_at       DateTime?
  decision_finance           String?
  details_json               Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  abonnement AbonnementCantine @relation(fields: [abonnement_cantine_id], references: [id])

  @@index([abonnement_cantine_id], map: "idx_abscant_abonnement")
  @@index([date_repas], map: "idx_abscant_date")
  @@index([finance_processed_at], map: "idx_abscant_finance_processed")
  @@map("absences_cantine")
}

/**
 * =========================
 * 13) DOCUMENTS
 * =========================
 */
model Fichier {
  id                          String   @id @default(uuid())
  etablissement_id            String
  proprietaire_utilisateur_id String?
  fournisseur_stockage        String?
  chemin                      String
  type_mime                   String?
  taille                      Int?
  checksum                    String?
  televerse_le                DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  proprietaire  Utilisateur?  @relation("fichiers_proprietaire", fields: [proprietaire_utilisateur_id], references: [id])
  liens         LienFichier[]
  documentsInscriptions InscriptionDocument[]

  @@index([etablissement_id])
  @@map("fichiers")
}

model LienFichier {
  id          String  @id @default(uuid())
  fichier_id  String
  type_entite String // eleves, factures, incidents...
  id_entite   String
  tag         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fichier Fichier @relation(fields: [fichier_id], references: [id])

  @@index([fichier_id])
  @@map("liens_fichiers")
}

model DocumentTypeInscription {
  id                         String   @id @default(uuid())
  etablissement_id           String?
  code                       String
  nom                        String
  description                String?
  type_inscriptions_json     Json?
  est_obligatoire_par_defaut Boolean  @default(false)
  est_actif                  Boolean  @default(true)
  ordre                      Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement?         @relation(fields: [etablissement_id], references: [id])
  documents     InscriptionDocument[]

  @@unique([etablissement_id, code])
  @@index([etablissement_id])
  @@map("documents_types_inscription")
}

model InscriptionDocument {
  id                         String                    @id @default(uuid())
  inscription_id             String
  document_type_id           String
  fichier_id                 String?
  verifie_par_utilisateur_id String?
  obligatoire                Boolean                   @default(false)
  fourni                     Boolean                   @default(false)
  statut                     StatutDocumentInscription @default(NON_FOURNI)
  date_depot                 DateTime?
  date_verification          DateTime?
  commentaire_admin          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  inscription  Inscription             @relation(fields: [inscription_id], references: [id])
  documentType DocumentTypeInscription @relation(fields: [document_type_id], references: [id])
  fichier      Fichier?                @relation(fields: [fichier_id], references: [id])
  verifiePar   Utilisateur?            @relation("documents_inscription_verifies", fields: [verifie_par_utilisateur_id], references: [id])

  @@unique([inscription_id, document_type_id])
  @@index([inscription_id])
  @@index([document_type_id])
  @@index([fichier_id])
  @@index([verifie_par_utilisateur_id])
  @@map("inscriptions_documents")
}

/**
 * =========================
 * 14) AUDIT & INTEGRATIONS
 * =========================
 */
model JournalAudit {
  id                    String   @id @default(uuid())
  etablissement_id      String
  acteur_utilisateur_id String?
  action                String
  type_entite           String?
  id_entite             String?
  avant_json            Json?
  apres_json            Json?
  ip                    String?
  date_action           DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])
  acteur        Utilisateur?  @relation(fields: [acteur_utilisateur_id], references: [id])

  @@index([etablissement_id])
  @@map("journaux_audit")
}

model Webhook {
  id               String  @id @default(uuid())
  etablissement_id String
  url              String
  evenements_json  Json?
  secret           String?
  est_actif        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])

  @@index([etablissement_id])
  @@map("webhooks")
}

model JetonIntegration {
  id               String    @id @default(uuid())
  etablissement_id String
  fournisseur      String
  token_json       Json
  expire_le        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id])

  @@index([etablissement_id])
  @@map("jetons_integrations")
}
